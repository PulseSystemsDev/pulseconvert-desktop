{
  "name": "pulseconvert-desktop",
  "version": "2.0.0",
  "description": "Pulse Convert Desktop - convert, optimize, and deploy GTA V mods for FiveM from Windows and Linux",
  "author": "Pulse Systems <support@pulsesystems.dev>",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/run-electron.js",
    "dev": "npm run build && npm start",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p renderer",
    "mock": "node scripts/mock-server.js",
    "demo": "npm run build && node scripts/demo.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "ssh2-sftp-client": "^12.1.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.186.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "homepage": "https://convert.pulsesystems.dev",
  "build": {
    "extends": "./electron-builder.yml"
  }
}
